{
  "expo": {
    "name": "PocketShot Coach",
    "slug": "pocketshot-coach",
    "scheme": "pocketshot-coach",
    "version": "0.0.1",
    "runtimeVersion": { "policy": "appVersion" },
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.lastshotlabs.pocketshot.coach",
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Capture a photo for your coaching analysis.",
        "NSPhotoLibraryUsageDescription": "Choose a photo for your coaching analysis."
      }
    },
    "android": { "package": "com.lastshotlabs.pocketshot.coach", "versionCode": 1 },
    "plugins": ["expo-router", "expo-image-picker"]
  }
}
