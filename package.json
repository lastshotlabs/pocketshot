{
  "name": "@lastshotlabs/pocketshot",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lastshotlabs/pocketshot.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "bin": {
    "pocketshot": "dist/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/types/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && NODE_OPTIONS=--max-old-space-size=8192 tsup && node scripts/finalize-package.mjs && tsc -p tsconfig.build.json && npm run check:package",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "check:package": "node scripts/check-package-budgets.mjs",
    "verify:consumer": "npm run build && node scripts/verify-package-consumer.mjs"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": ">=11.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "expo-application": ">=5.0.0",
    "expo-clipboard": ">=7.0.0",
    "expo-constants": ">=17.0.0",
    "expo-device": ">=6.0.0",
    "expo-haptics": ">=14.0.0",
    "expo-linking": ">=6.0.0",
    "expo-local-authentication": ">=14.0.0",
    "expo-notifications": ">=0.28.0",
    "expo-router": ">=4.0.0",
    "expo-secure-store": ">=14.0.0",
    "expo-sharing": ">=12.0.0",
    "expo-sqlite": ">=14.0.0",
    "jotai": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0",
    "react-native-sse": ">=2.0.0",
    "zod": ">=4.0 <5"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    },
    "expo-local-authentication": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "react-native-sse": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@lastshotlabs/frontend-contract": "^0.2.2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.99.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^22.0.0",
    "expo-clipboard": "file:tests/stubs/expo-clipboard",
    "expo-sharing": "file:tests/stubs/expo-sharing",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "expo-router": "^55.0.12",
    "expo-secure-store": "^55.0.13",
    "jotai": "^2.19.1",
    "prettier": "^3.8.1",
    "react": "^19.2.5",
    "react-native": "^0.85.1",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.11.2",
    "react-test-renderer": "19.2.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6",
    "zod": ">=4.0"
  }
}
