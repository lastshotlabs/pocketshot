{
  "name": "@lastshotlabs/hitshot-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    "./app": "./app/index.tsx",
    "./native-intent": "./app/+native-intent.ts",
    "./join-route": "./app/join/[code].tsx",
    "./lib": "./lib/party.ts",
    "./link": "./lib/party-link.ts"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --output-dir dist/ios --clear && expo export --platform android --output-dir dist/android --clear"
  },
  "dependencies": {
    "@lastshotlabs/pocketshot": "0.1.2",
    "expo": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
