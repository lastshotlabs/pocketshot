{
  "expo": {
    "name": "AICoach",
    "slug": "aicoach",
    "scheme": "aicoach",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06133f"
    },
    "runtimeVersion": { "policy": "appVersion" },
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.lastshotlabs.aicoach",
      "buildNumber": "1",
      "associatedDomains": ["applinks:links.aicoach.app"],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Capture progress photos for coaching analysis.",
        "NSPhotoLibraryUsageDescription": "Choose progress photos for coaching analysis."
      }
    },
    "android": {
      "package": "com.lastshotlabs.aicoach",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06133f"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "links.aicoach.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "aicoach" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "favicon": "./assets/icon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-notifications", { "icon": "./assets/icon.png", "color": "#2F80ED" }],
      "expo-image-picker"
    ]
  }
}
