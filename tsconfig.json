{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "types": ["node", "react"],
    "paths": {
      "@/*": ["./src/*"],
      "@ui-test/*": ["./tests/ui/*"],
      "@lastshotlabs/frontend-contract": ["../frontend-contract/src/index.ts"],
      "@lastshotlabs/frontend-contract/*": ["../frontend-contract/src/*"],
      "@lastshotlabs/pocketshot/ai": ["./src/ai/index.ts"],
      "@lastshotlabs/pocketshot/auth": ["./src/auth/index.ts"],
      "@lastshotlabs/pocketshot/audio": ["./src/audio/index.ts"],
      "@lastshotlabs/pocketshot/billing": ["./src/billing/index.ts"],
      "@lastshotlabs/pocketshot/coach": ["./src/coach/index.ts"],
      "@lastshotlabs/pocketshot/party": ["./src/party/index.ts"],
      "@lastshotlabs/pocketshot/party-session": ["./src/party-session/index.ts"],
      "@lastshotlabs/pocketshot/release": ["./src/release/index.ts"],
      "@lastshotlabs/pocketshot/privacy": ["./src/privacy/index.ts"],
      "@lastshotlabs/pocketshot/observability": ["./src/observability/index.ts"],
      "@lastshotlabs/pocketshot/accessibility": ["./src/accessibility/index.ts"],
      "@lastshotlabs/pocketshot/community/core": ["./src/community/core.ts"],
      "@lastshotlabs/pocketshot/community": ["./src/community/index.ts"],
      "@lastshotlabs/pocketshot/drafts": ["./src/drafts/index.ts"],
      "@lastshotlabs/pocketshot/offline": ["./src/offline/index.ts"],
      "@lastshotlabs/pocketshot/media": ["./src/media/index.ts"],
      "@lastshotlabs/pocketshot/upload": ["./src/upload/index.ts"],
      "@lastshotlabs/pocketshot/push": ["./src/push/index.ts"],
      "@lastshotlabs/pocketshot/realtime": ["./src/realtime/index.ts"],
      "@lastshotlabs/hitshot-mobile/lib": ["./products/hitshot/lib/party.ts"],
      "@lastshotlabs/hitshot-mobile/link": ["./products/hitshot/lib/party-link.ts"],
      "@lastshotlabs/aicoach-mobile/lib": ["./products/aicoach/lib/coach.ts"],
      "@lastshotlabs/aicoach-mobile/services": ["./products/aicoach/lib/coach-services.ts"],
      "@lastshotlabs/sgforum-mobile/lib": ["./products/sgforum/lib/community.ts"],
      "@lastshotlabs/burndown-mobile/lib": ["./products/burndown/lib/burndown.ts"],
      "@lastshotlabs/burndown-mobile/link": ["./products/burndown/lib/link.ts"],
      "@lastshotlabs/blankslate-mobile/lib": ["./products/blankslate/lib/blankslate.ts"],
      "@lastshotlabs/blankslate-mobile/link": ["./products/blankslate/lib/link.ts"]
    }
  },
  "include": ["src", "tests"]
}
