{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ui-test/*": ["./tests/ui/*"]
    }
  },
  "include": ["src", "tests"]
}
